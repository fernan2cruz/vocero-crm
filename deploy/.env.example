# Wassapi — configuración del servidor piloto.
#   ./scripts/gen-env.sh crm.tudominio.com   crea .env con los secretos CHANGE_ME ya generados.
# .env NO se versiona. Guarda una copia APARTE del servidor: ENCRYPTION_KEY cifra los secretos de la base.

# --- Dominio y TLS ------------------------------------------------------------
DOMAIN=CHANGE_ME_crm.tudominio.com
# Vacío = Let's Encrypt automático (DNS del dominio apuntando a este servidor, puertos 80 y 443 abiertos).
# "tls internal" = certificado propio de Caddy (pruebas, o detrás de Cloudflare Tunnel).
CADDY_TLS=
# Correo para avisos de Let's Encrypt, p. ej.:  CADDY_GLOBAL=email admin@tudominio.com
CADDY_GLOBAL=
# 127.0.0.1 cuando un túnel del mismo servidor es la única entrada.
BIND_ADDR=0.0.0.0
# Cloudflare Tunnel (solo con --profile tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Secretos (los genera gen-env.sh) ----------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
BETTER_AUTH_SECRET=CHANGE_ME
# 32 bytes en base64: openssl rand -base64 32. Si se pierde, los secretos guardados en la base no se recuperan.
ENCRYPTION_KEY=CHANGE_ME
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
# Llave de servicio del agente (Nea) con el CRM.
BOT_API_KEY=CHANGE_ME

# --- Plataforma multi-negocio -------------------------------------------------
# Portal de superadmin en /platform. Vacío = una instalación de un solo negocio.
PLATAFORMA=on
# Solo para crear la PRIMERA cuenta (la del superadmin): ponlo en true, regístrate, otórgale superadmin
# (docker compose -f docker-compose.prod.yml exec app node platform-grant.mjs correo) y déjalo vacío otra vez.
ALLOW_SIGNUP=
# Días del historial de accesos; purga diaria por lotes, solo con PLATAFORMA=on.
ACCESS_RETENTION_DAYS=180

# --- WhatsApp (Meta) y IA -----------------------------------------------------
# OBLIGATORIO con PLATAFORMA=on: App Secret de Meta → Configuración → Básica.
# Sin él, los webhooks de Meta responden 503; nunca se aceptan sin firma.
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
# La IA se configura desde la app (con PLATAFORMA=on, la llave de cada negocio o la de plataforma la pone
# el superadmin). Estas solo son el respaldo mientras no haya nada guardado ahí.
OPENROUTER_API_TOKEN=
OPENROUTER_MODEL=
# Mientras pruebas: tu número (código de país, sin +). Vacío = el agente le contesta a todos.
ALLOWED_WA_IDS=

# --- Módulos opcionales (vacío = apagado) -------------------------------------
CHANNELS=
AGENDA=
ATRIBUCION=

# --- Agente (Nea) -------------------------------------------------------------
# Con la imagen oficial, un solo negocio. Varios negocios: la Nea del fork, construida por ti:
#   NEA_IMAGE=wassapi-nea  NEA_VERSION=1  NEA_VOCERO_MODE=cloud  NEA_CRM_SURFACE=bot
NEA_IMAGE=ghcr.io/kevinrivm/nea-agent
NEA_VERSION=2.0.2
NEA_VOCERO_MODE=
NEA_CRM_SURFACE=
# Días de despachos terminados en Nea (incluyen mensajes); purga diaria por lotes.
DISPATCH_RETENTION_DAYS=14

# --- Respaldos ----------------------------------------------------------------
BACKUP_HOUR_UTC=07
BACKUP_RETENTION_DAYS=14

# --- Recursos (ajusta al tamaño del servidor) ---------------------------------
APP_CPUS=2.0
APP_MEM=768M
PG_CPUS=2.0
PG_MEM=1G
PG_SHARED_BUFFERS=256MB

# Lo escribe deploy.sh.
IMAGE_TAG=latest
